{
  "name": "chirp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, AI-moderated comment widget for static sites",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply chirp --local",
    "db:migrate:remote": "wrangler d1 migrations apply chirp --remote",
    "db:seed:preview": "wrangler d1 execute chirp --local --file=./scripts/seed-preview.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "workerd@1.20260815.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
